{
  "name": "9sprints-website",
  "version": "1.0.0",
  "private": true,
  "description": "9Sprints - Technology, Put Into Motion. Static marketing site.",
  "scripts": {
    "pages": "node scripts/build-pages.mjs",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "node scripts/build-pages.mjs && tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "serve": "npx --yes serve . -l 5173"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.0",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
